Below table represents One to Many relationship -
One student can make multiple home work submission, based on that criteria we created below table.
CREATE TABLE homework_submission (
	id SERIAL PRIMARY KEY,
	mark INTEGER,
	student_id INTEGER REFERENCES student(id)  // student_id is foriegn key column of this table, reference id column of student table.
);

INSERT INTO homework_submission (mark, student_id)
VALUES (98,1),(87,1),(88,1);

// To display the data from two tables
SELECT * FROM
student  JOIN
homework_submission
ON student.id = student_id;

// To select only particular columns from two tables
SELECT student.id, first_name, last_name, mark
FROM student
JOIN homework_submission
ON student.id = student_id;
